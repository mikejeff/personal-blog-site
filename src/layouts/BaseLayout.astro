---
import { Debug } from "astro:components";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SEO } from "astro-seo";
// https://github.com/jonasmerlin/astro-seo#readme
interface Props {
  canonical?: string;
  description?: string;
  noarchive?: boolean;
  nocache?: boolean;
  nofollow?: boolean;
  noindex?: boolean;
  robotsExtras?: string;
  title: string;
  titleTemplate?: string;
  openGraph?: {
    basic?: {
      title?: string;
      type?: string;
      image?: string;
      url?: string;
    };
    optional?: {
      audio?: string;
      description?: string;
      determiner?: string;
      locale?: string;
      localeAlternate?: Array<string>;
      siteName?: string;
      video?: string;
    };
  };
}

// import "@fontsource-variable/source-serif-4";
// import "@fontsource-variable/source-sans-3";
import "virtual:sugarcube.css";
import "../styles/main.css";
const {
  canonical,
  description,
  noarchive,
  nocache,
  nofollow,
  noindex,
  openGraph,
  robotsExtras,
  title,
  titleTemplate = "%s | Mike Jeffery",
} = Astro.props;

const og = {
  basic: {
    title: openGraph?.basic?.title ?? title,
    type: openGraph?.basic?.type ?? "website",
    image:
      openGraph?.basic?.image ??
      "https://mikejeff.com/images/opengraph/default.png",
    url: openGraph?.basic?.url ?? canonical ?? Astro.url.href,
  },
  optional: {
    description: openGraph?.optional?.description ?? description,
    siteName: openGraph?.optional?.siteName ?? "Mike Jeffery",
    ...openGraph?.optional,
  },
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      canonical={canonical}
      description={description}
      noarchive={noarchive}
      nocache={nocache}
      nofollow={nofollow}
      noindex={noindex}
      openGraph={og}
      robotsExtras={robotsExtras}
      title={title}
      titleDefault="Mike Jeffery | Front-end web developer"
      titleTemplate={titleTemplate}
    />
  </head>
  <body>
    <Header />
    <!-- <Debug {og} /> -->
    <main class="wrapper">
      <article>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
