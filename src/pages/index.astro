---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/homepage.css";
const pageTitle = "Home | Mike Jeffery";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="homepage-hero">
    <header>
      <div class="homepage-hero__grid">
        <div class="homepage-hero__image">
          <img
            width="300"
            height="300"
            src="public/images/portrait.png"
            alt="An illustrated portrait of a slightly burly guy with an affable nature and a dark brown beard. He's wearing a black Montreal Expos cap and a gray t-shirt."
          />
        </div>

        <div class="homepage-hero__heading">
          <h1>
            Hi, I'm Mike Jeffery. I work to make life easier for everyone on the
            web.
          </h1>
        </div>
      </div>

      <p class="homepage-hero__text">
        A front-end developer near Boston, MA. I've spent over a decade working
        on systems to make websites durable and inclusive.
      </p>
    </header>
  </section>
  <section class="homepage-text | flow">
    <p>
      I design and build websites focused on accessibility, performance, and
      long-term maintainability. My approach brings practical design sensibility
      to every project—I believe websites should be simple, durable, and easy to
      use.
    </p>
    <p>
      I've spent my career so far working for a leader in the travel industry
      maintaining sites for major brands. Home is North Reading, where my
      partner and I raise two amazing kids. I play music, collect retro video
      games, and work on small electronics projects when the sun goes down.
    </p>
    <!-- <p><a href="/about">Read more about my journey</a></p> -->
  </section>
  <aside class="homepage-notes | flow">
    <h2>Bench Notes</h2>
    <div class="homepage-notes__list-wrap">
      <div class="homepage-notes__list | flow">
        <h3>Principles</h3>
        <ul>
          <li>Respect the platform.</li>
          <li>Simplicity scales.</li>
          <li>Leave it better than you found it.</li>
        </ul>
      </div>
      <div class="homepage-notes__list | flow">
        <h3>Inspired By</h3>
        <ul>
          <li><a href="https://cube.fyi">CUBE CSS</a></li>
          <li>
            <a href="https://elenajs.com">Elena</a>
          </li>
          <li>
            <a href="https://piccalil.li/mindful-design">Mindful Design</a>
          </li>
          <li>
            <a href="https://sugarcube.sh">sugarcube</a>
          </li>
        </ul>
      </div>
      <div class="homepage-notes__list | flow">
        <h3>On the Bench</h3>
        <ul>
          <li>Site redesign</li>
          <li>Web Components</li>
          <li>Design systems</li>
        </ul>
      </div>
    </div>
  </aside>
</BaseLayout>
