---
interface Props {
  description?: string;
  fullTitle?: string;
  nofollow?: boolean;
  noindex?: boolean;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogPublishedTime?: string;
  ogTags?: string[];
  ogTitle?: string;
  ogType?: string;
  title?: string;
}

const pageUrl = Astro.url.href;

// const ogImage = "/images/opengraph/default.png";

const {
  description,
  fullTitle,
  nofollow = false,
  noindex = false,
  ogDescription,
  ogImage,
  ogImageAlt,
  ogPublishedTime,
  ogTags = [],
  ogTitle,
  ogType,
  title,
} = Astro.props;

const pageTitle =
  fullTitle ??
  (title
    ? `${title} | Mike Jeffery`
    : "Mike Jeffery | Front-end web developer");
---

{/* Document basics */}
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />

{/* Primary SEO */}
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href= {pageUrl} />

{/* Robots */}
{noindex && <meta name="robots" content="noindex" />}
{nofollow && <meta name="robots" content="nofollow" />}


{/* OpenGraph: basic (required) */}
{
  ogTitle ? (
    <meta property="og:title" content={ogTitle} />
  ) : (
    <meta property="og:title" content={pageTitle} />
  )
}

{
  ogType ? (
    <meta property="og:type" content={ogType} />
  ) : (
    <meta property="og:type" content="website" />
  )
}

<meta property="og:url" content={pageUrl} />

 {/* OpenGraph: basic: image */}

{
  ogImage ? (
    <meta property="og:image" content={`${Astro.url.origin}${ogImage}`} />
    <meta property="og:image:secure_url" content={`${Astro.url.origin}${ogImage}`} />
    <meta property="og:image:alt" content= {ogImageAlt} />
  ) : (
    <meta
      property="og:image"
      content={`${Astro.url.origin}/images/opengraph/default.jpg`}
    />
    <meta property="og:image:secure_url" content={`${Astro.url.origin}/images/opengraph/default.jpg`} />
    <meta
      property="og:image:alt"
      content="Mike Jeffery. HTML, CSS, and a love for the web."
    />
  )
}

<meta property="og:image:type" content="image/jpg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{/* OpenGraph: optional for ALL */}
{
  ogDescription ? (
    <meta property="og:description" content={ogDescription} />
  ) : (
    <meta property="og:description" content={description} />
  )

}

{/* OpenGraph: optional for articles */}
{
  ogType === "article" && (
    <>
      {<meta property="article:author" content="Mike Jeffery" />}
      {<meta property="article:section" content="Web Development" />}
      {ogPublishedTime && (
        <meta property="article:published_time" content={ogPublishedTime} />
      )}
      {ogTags.map((ogTags) => (
        <meta property="article:tag" content={ogTags} />
      ))}
    </>
  )
}

{/* Icons / PWA */}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

{/* article:modified_time - datetime - When the article was last changed. */}
