---
import InlineLinkList from "./InlineLinkList.astro";
import "../styles/footer.css";
---

<footer class="site-footer">
  <div class="site-footer__inner-wrap | wrapper flow">
    <InlineLinkList
      heading="Guides"
      links={[
        {
          label: "Git Conventions",
          href: "/guides/git-conventions",
        },
      ]}
    />
    <InlineLinkList
      heading="Find me elsewhere on the web"
      links={[
        {
          label: "BlueSky",
          href: "https://bsky.app/profile/mikejeff.com",
        },
        {
          label: "LinkedIn",
          href: "https://www.linkedin.com/in/mikejeffdev/",
        },
        {
          label: "GitHub",
          href: "https://github.com/mikejeff",
        },
      ]}
    />
    <h2 class="site-footer__heading"></h2>
    <p><a href=""></a></p>
    <div class="site-footer__copyright">
      <p>
        <small
          >© <span id="copyrightYear">2025-2026</span> Michael R Jeffery. All rights
          reserved.</small
        >
      </p>
      <p>
        <small
          >Built on <a href="https://astro.build/">Astro</a> with HTML, CSS & a love
          of the web.</small
        >
      </p>
    </div>
    <script>
      const copyrightYear = document.getElementById("copyrightYear");
      const year = new Date().getFullYear();
      if (copyrightYear) {
        if (year >= 2026) {
          copyrightYear.textContent = "2025-" + year.toString();
        } else {
          copyrightYear.textContent = year.toString();
        }
      }
    </script>
  </div>
</footer>
